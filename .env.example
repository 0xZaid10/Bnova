# Secrets: set these on the server only. Never commit this file with values filled in.
AGENT_GAMES_HMAC_SECRET=

# Server
PORT=8080
AGENT_PATH=/agent
DB_PATH=./data/agent.db
CIRCUIT_DIR=./circuits
LOG_LEVEL=info

# Protocol details to confirm in practice mode
# How the HMAC key is read: utf8 (the secret text as is) or hex (secret is hex bytes)
SECRET_ENCODING=utf8
# How we format the signature header: hex | sha256-prefixed | base64
SIGNATURE_FORMAT=hex
# How task_id becomes the circuit number: keccak | sha256 | utf8 | hex-tail
TASK_ID_MODE=keccak

# Hard stop before the 60 second platform deadline (milliseconds)
HARD_DEADLINE_MS=50000
